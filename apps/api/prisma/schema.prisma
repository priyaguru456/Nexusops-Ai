generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum RequestCategory {
  IT
  HR
  FINANCE
  FACILITIES
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum DocVisibility {
  ALL
  DEPARTMENT
  MANAGERS
  ADMIN_ONLY
}

enum DocStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum ChatRole {
  USER
  ASSISTANT
}

enum AnnouncementPriority {
  NORMAL
  URGENT
}

enum PolicyCategory {
  HR
  SECURITY
  TRAVEL
  OTHER
}

model Department {
  id            String         @id @default(uuid())
  name          String         @unique
  users         User[]
  documents     Document[]
  announcements Announcement[]
  policyDocuments Document[]   @relation("TargetDepartment")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  managerId String?
  manager   User?   @relation("ManagerReports", fields: [managerId], references: [id])
  reports   User[]  @relation("ManagerReports")

  refreshTokens RefreshToken[]
  requests      WorkRequest[]  @relation("Requester")
  tasksAssigned Task[]         @relation("Assignee")
  tasksCreated  Task[]         @relation("AssignedBy")
  approvalsMade ApprovalStep[]
  approvalFlowStepsAssigned ApprovalFlowStep[] @relation("FlowStepApprover")
  documents     Document[]
  chatSessions  ChatSession[]
  notifications Notification[]
  comments      Comment[]
  auditLogs     AuditLog[]
  announcementsCreated Announcement[]     @relation("AnnouncementAuthor")
  announcementReads    AnnouncementRead[]
  assignedAssets       AssetAssignment[]      @relation("UserAssetAssignments")
  assetsGiven          AssetAssignment[]      @relation("AdminAssignedAssets")
  acknowledgements     Acknowledgement[]
  leaveBalances        LeaveBalance[]         @relation("UserLeaveBalances")
  leaveRequests        LeaveRequest[]         @relation("EmployeeLeaves")
  decidedLeaves        LeaveRequest[]         @relation("DecidedLeaves")
  expenseClaims        ExpenseClaim[]         @relation("EmployeeExpenseClaims")
  digestSchedules      DigestSchedule[]       @relation("DigestScheduleCreator")
  surveyResponses      SurveyResponse[]

  @@index([role])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model WorkRequest {
  id          String          @id @default(uuid())
  title       String
  description String
  category    RequestCategory
  priority    Priority        @default(MEDIUM)
  status      RequestStatus   @default(DRAFT)
  amount      Decimal?        @db.Decimal(12, 2)
  dueDate     DateTime?
  submittedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  requesterId String
  requester   User   @relation("Requester", fields: [requesterId], references: [id])

  attachments   RequestAttachment[]
  tasks         Task[]
  approvalSteps ApprovalStep[]
  flowId        String?
  flow          ApprovalFlow?       @relation(fields: [flowId], references: [id], onDelete: SetNull)
  assetAssignments AssetAssignment[]

  @@index([status])
  @@index([requesterId])
  @@index([flowId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([requesterId, createdAt])
}

model RequestAttachment {
  id        String      @id @default(uuid())
  requestId String
  request   WorkRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileName  String
  filePath  String
  createdAt DateTime    @default(now())
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  requestId String?
  request   WorkRequest? @relation(fields: [requestId], references: [id])

  assigneeId   String?
  assignee     User?   @relation("Assignee", fields: [assigneeId], references: [id])
  assignedById String?
  assignedBy   User?   @relation("AssignedBy", fields: [assignedById], references: [id])

  @@index([status])
  @@index([assigneeId])
  @@index([createdAt])
  @@index([status, dueDate])
  @@index([assigneeId, status])
}

model Comment {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  body       String
  createdAt  DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model ApprovalFlow {
  id        String             @id @default(uuid())
  name      String
  category  RequestCategory
  minAmount Decimal            @default(0) @db.Decimal(12, 2)
  maxAmount Decimal?           @db.Decimal(12, 2)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  steps     ApprovalFlowStep[]
  requests  WorkRequest[]

  @@index([category, isActive])
  @@index([createdAt])
}

model ApprovalFlowStep {
  id           String        @id @default(uuid())
  flowId       String
  flow         ApprovalFlow  @relation(fields: [flowId], references: [id], onDelete: Cascade)
  stepOrder    Int
  approverRole Role?
  approverId   String?
  approver     User?         @relation("FlowStepApprover", fields: [approverId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([flowId, stepOrder])
  @@index([flowId])
  @@index([approverId])
}

model ApprovalStep {
  id           String         @id @default(uuid())
  entityType   String         @default("REQUEST")
  entityId     String
  requestId    String?
  request      WorkRequest?   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepOrder    Int
  approverRole Role
  approverId   String?
  approver     User?          @relation(fields: [approverId], references: [id])
  status       ApprovalStatus @default(PENDING)
  comment      String?
  decidedAt    DateTime?
  activatedAt  DateTime?
  escalatedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([entityType, entityId, stepOrder])
  @@index([status])
  @@index([approverId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([approverId, status, decidedAt])
  @@index([status, activatedAt, escalatedAt])
}

model Document {
  id           String        @id @default(uuid())
  title        String
  fileName     String
  filePath     String
  mimeType     String
  sizeBytes    Int
  category     String?
  visibility   DocVisibility @default(ALL)
  status       DocStatus     @default(UPLOADED)
  errorMessage String?
  version      Int           @default(1)
  isPolicy     Boolean       @default(false)
  isMandatory  Boolean       @default(false)
  createdAt    DateTime      @default(now())

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  targetDepartmentId String?
  targetDepartment   Department? @relation("TargetDepartment", fields: [targetDepartmentId], references: [id])
  uploadedById String
  uploadedBy   User        @relation(fields: [uploadedById], references: [id])

  chunks DocumentChunk[]
  acknowledgements Acknowledgement[]

  @@index([status])
  @@index([uploadedById])
  @@index([createdAt])
  @@index([isPolicy])
  @@index([targetDepartmentId])
}

model Acknowledgement {
  id             String    @id @default(uuid())
  documentId     String
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  version        Int
  acknowledgedAt DateTime  @default(now())

  @@unique([documentId, userId, version])
  @@index([documentId])
  @@index([userId])
  @@index([documentId, version])
}

model DocumentChunk {
  id         String                        @id @default(uuid())
  documentId String
  document   Document                      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  pageNumber Int?
  content    String
  tokenCount Int?
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                      @default(now())

  @@index([documentId])
  @@index([createdAt])
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id           String      @id @default(uuid())
  sessionId    String
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role         ChatRole
  content      String
  citations    Json?
  tokensUsed   Int?
  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int?
  feedback     Int?
  notFound     Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@index([sessionId])
  @@index([createdAt])
  @@index([notFound])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String    @default("")
  message    String
  link       String?
  entityType String?
  entityId   String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  summary    String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

model Announcement {
  id                 String               @id @default(uuid())
  title              String
  content            String               @db.Text
  priority           AnnouncementPriority @default(NORMAL)
  targetDepartmentId String?
  targetDepartment   Department?          @relation(fields: [targetDepartmentId], references: [id])
  authorId           String
  author             User                 @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  isPinned           Boolean              @default(false)
  expiresAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  reads              AnnouncementRead[]

  @@index([isPinned, createdAt])
  @@index([targetDepartmentId])
  @@index([authorId])
  @@index([priority])
  @@index([expiresAt])
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
  @@index([announcementId])
}

enum AssetType {
  LAPTOP
  MONITOR
  PHONE
  LICENSE
  ACCESSORY
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_REPAIR
  RETIRED
}

model Asset {
  id                String            @id @default(uuid())
  name              String
  type              AssetType
  serialNumber      String?           @unique
  status            AssetStatus       @default(AVAILABLE)
  purchaseDate      DateTime?
  warrantyExpiresAt DateTime?
  notes             String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  assignments       AssetAssignment[]

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([warrantyExpiresAt])
}

model AssetAssignment {
  id           String       @id @default(uuid())
  assetId      String
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation("UserAssetAssignments", fields: [userId], references: [id], onDelete: Cascade)
  assignedAt   DateTime     @default(now())
  returnedAt   DateTime?
  assignedById String
  assignedBy   User         @relation("AdminAssignedAssets", fields: [assignedById], references: [id], onDelete: Restrict)
  requestId    String?
  request      WorkRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  notes        String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([assetId])
  @@index([userId])
  @@index([requestId])
  @@index([assignedById])
  @@index([returnedAt])
  @@index([assignedAt])
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveBalance {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation("UserLeaveBalances", fields: [userId], references: [id], onDelete: Cascade)
  year       Int
  casualDays Int      @default(12)
  sickDays   Int      @default(12)
  annualDays Int      @default(15)
  usedCasual Int      @default(0)
  usedSick   Int      @default(0)
  usedAnnual Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, year])
  @@index([userId])
  @@index([year])
}

model LeaveRequest {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation("EmployeeLeaves", fields: [userId], references: [id], onDelete: Cascade)
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  daysCount  Int
  reason     String
  status     LeaveStatus @default(PENDING)
  approverId String?
  approver   User?       @relation("DecidedLeaves", fields: [approverId], references: [id], onDelete: SetNull)
  decidedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([createdAt])
}

model Holiday {
  id        String   @id @default(uuid())
  name      String
  date      DateTime @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

enum ExpenseCategory {
  TRAVEL
  MEALS
  SOFTWARE
  OFFICE
  OTHER
}

model ExpenseClaim {
  id               String        @id @default(uuid())
  title            String
  totalAmount      Int           @default(0)
  status           ExpenseStatus @default(DRAFT)
  employeeId       String
  employee         User          @relation("EmployeeExpenseClaims", fields: [employeeId], references: [id], onDelete: Cascade)
  submittedAt      DateTime?
  paidAt           DateTime?
  paymentReference String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items            ExpenseItem[]

  @@index([employeeId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentReference])
}

model ExpenseItem {
  id          String          @id @default(uuid())
  claimId     String
  claim       ExpenseClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  amount      Int
  receiptUrl  String?
  description String?
  date        DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([claimId])
  @@index([category])
  @@index([date])
}

enum DigestFrequency {
  WEEKLY
}

enum DigestDeliveryStatus {
  SUCCESS
  FAILED
  PENDING
}

model DigestSchedule {
  id         String           @id @default(uuid())
  recipients String[]
  frequency  DigestFrequency  @default(WEEKLY)
  dayOfWeek  Int              // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  hour       Int              // 0 - 23
  timezone   String           @default("Asia/Kolkata")
  isActive   Boolean          @default(true)
  lastRunAt  DateTime?
  createdBy  String
  creator    User             @relation("DigestScheduleCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  deliveries DigestDelivery[]

  @@index([isActive])
  @@index([createdBy])
}

model DigestDelivery {
  id             String               @id @default(uuid())
  scheduleId     String?
  schedule       DigestSchedule?      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  sentAt         DateTime             @default(now())
  status         DigestDeliveryStatus @default(PENDING)
  error          String?
  recipientCount Int                  @default(0)
  createdAt      DateTime             @default(now())

  @@index([scheduleId])
  @@index([status])
  @@index([sentAt])
}

model Survey {
  id         String          @id @default(uuid())
  title      String
  isActive   Boolean         @default(true)
  targetRole Role?
  questions  Json
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  responses  SurveyResponse[]

  @@index([isActive])
  @@index([targetRole])
  @@index([createdAt])
}

model SurveyResponse {
  id         String   @id @default(uuid())
  surveyId   String
  survey     Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String   @default("REQUEST")
  entityId   String
  answers    Json
  createdAt  DateTime @default(now())

  @@unique([userId, entityType, entityId])
  @@index([surveyId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}


