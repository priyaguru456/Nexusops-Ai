# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL 16 with pgvector)
# Special characters in the password must be URL-encoded (@ = %40, % = %25, space = %20).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexusops_ai?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/nexusops_ai?schema=public

# Redis (BullMQ / Caching)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_chars_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECURE=false
BCRYPT_ROUNDS=10

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# AI / RAG
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_API_KEY=
EMBEDDING_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=6
SIMILARITY_THRESHOLD=0.3
